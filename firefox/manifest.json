{
  "manifest_version": 2,
  "name": "Tor IP (Raspberry Pi)",
  "version": "2.0",
  "description": "Ağdaki Raspberry Pi üzerindeki Tor'a bağlanır; ülke seç, tek tıkla IP değiştir.",
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "alarms",
    "notifications",
    "<all_urls>",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Tor IP"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tor-ip@ehm.local",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "128": "icon.png"
  }
}